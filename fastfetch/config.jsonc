{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "display": {
    "separator": "  ",
    "color": {
	"keys": "cyan",
	"output": "default"
     },
    "key": {
      "type": "both",
      "width": 13
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "●",
        "total": "○"
      }
    }
  },

  "modules": [
    "separator",

    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "Memory",
      "percent": {
        "type": 3
      }
    },
    {
      "type": "disk",
      "key": "Disk",
      "percent": {
        "type": 3
      }
    },

    "break"
  ]
}
