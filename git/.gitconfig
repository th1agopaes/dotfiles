[init]
	defaultBranch = main
[user]
	name = Thiago Paes
	email = 227227421+th1agopaes@users.noreply.github.com
	signingkey = /home/kajik/.ssh/id_ed25519.pub
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[core]
	pager = less -FRX
	autocrlf = input
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgsign = true
