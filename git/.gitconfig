[init]
	defaultBranch = main
[user]
	name = Thiago Paes
	email = 227227421+th1agopaes@users.noreply.github.com
	signingkey = /home/kajik/.ssh/id_ed25519.pub
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[core]
	pager = less -FRX
	autocrlf = input
	excludesFile = ~/.gitignore_global
[push]
	autoSetupRemote = true
	followTags = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
	verbose = true
[tag]
	gpgsign = true
	sort = version:refname
[gpg "ssh"]
	allowedSignersFile = /home/kajik/.config/git/allowed_signers
[help]
	autocorrect = prompt
[fetch]
	prune = true
[diff]
	algorithm = histogram
	colorMoved = plain
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate
[column]
	ui = auto
[pull]
	ff = only
[rebase]
	autoSquash = true
	autoStash = true
[transfer]
	fsckObjects = true
[safe]
	bareRepository = explicit
